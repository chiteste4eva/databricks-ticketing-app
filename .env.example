# Lakebase connection string (local dev). Get it from Databricks:
# Catalog > Lakebase > your instance > connection details.
# Format: postgresql://<role>:<password>@<host>:5432/databricks_postgres?sslmode=require
LAKEBASE_URL=postgresql://<role>:<password>@<host>:5432/databricks_postgres?sslmode=require
